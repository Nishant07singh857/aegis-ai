# Base URL of the AEGIS AI backend API.
#
# NOTE: NEXT_PUBLIC_ variables are inlined into the client bundle at BUILD
# time, so changing this after building has no effect. When building the
# production Docker image, pass it as a build-arg:
#   docker build --build-arg NEXT_PUBLIC_API_URL=http://backend:8000 .
NEXT_PUBLIC_API_URL=http://localhost:8000
