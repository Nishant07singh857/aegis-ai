# H24 (Integrity Fix Pack): widened from the exact-name list above to
# patterns, so .env.staging, foo.env, private keys and Kaggle credentials
# can never be committed by accident either.
*.env
.env.*
!.env.example
*.pem
*.key
kaggle.json
# NOTE: .env.example is intentionally NOT ignored — it is the committed
# template with placeholder values only (zero real secrets).
.ruff_cache/
.pytest_cache/
# Ignore video and training data
backend/dataset/
backend/tests/fixtures/sample_videos/
*.mp4
*.avi
*.mkv
*.mov
*.wmv

# Runtime log files (written on every backend run — never commit)
backend/data/logs/

# W3 audio pipeline — runtime artifacts (never commit)
.local-voices/
audio_out/

# Local analysis junk: never commit (venv 462MB + 17GB datasets)
analysis-env/
data/
